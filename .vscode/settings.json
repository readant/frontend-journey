{
  // ========== 编辑器核心设置 ==========
  "editor.tabSize": 2, // Tab 键宽度为 2 个字符
  "editor.insertSpaces": true, //  按 Tab 插入空格（与 Prettier/EC 保持一致）
  "editor.detectIndentation": false, // 锁定缩进模式，不自动猜测（避免冲突）
  "editor.formatOnSave": true, // 保存时自动格式化

  // ========== 全局格式化工具 ==========
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // ========== 语言特定优化 ==========
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" //
  },

  // ========== Markdown 笔记专用设置 ==========
  // 针对你学习笔记的 markdownlint 规则放宽
  "markdownlint.config": {
    "MD013": false, // 禁用行长度限制（对中文笔记友好）
    "MD033": false, // 允许内联 HTML（方便贴示例）
    "MD041": false, // 不强制第一行是标题
    "MD024": false, // 允许重复标题
    "MD029": false // 列表编号不要求有序
  },
  "markdownlint.run": "onType", // 输入时实时检查

  // Markdown 文件保存时不要让 Prettier 乱动表格或硬换行
  //（结合 Prettier 里 proseWrap: "always" 已经很友好）
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode" // 保留格式化（默认 true，显式写出来便于理解）
  },
  "liveServer.settings.port": 5501,

  // ========== npm 任务检测 ==========
  // 关闭自动扫描：Cursor 检测器对「根目录 + 嵌套多工程」结构解析有 bug，
  // 会误报"无法分析 package.json"（文件本身合法，已用 Node 严格解析验证）。
  // 一键运行能力由 .vscode/tasks.json 显式声明兜底，不受影响。
  "npm.autoDetect": "off"
}
